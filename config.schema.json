{
  "pluginAlias": "ComelitIntercom",
  "pluginVersion": ">=2.0.0-beta.0",
  "pluginType": "platform",
  "singular": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Comelit Intercom",
        "required": true
      },
      "host": {
        "title": "Device Host / IP Address",
        "type": "string",
        "required": true,
        "placeholder": "192.168.1.100"
      },
      "port": {
        "title": "ICONA Bridge Port",
        "type": "integer",
        "default": 64100
      },
      "token": {
        "title": "Auth Token (32-char hex \u2014 from device admin page at http://<host>:8080)",
        "type": "string",
        "required": true
      },
      "enableNotifications": {
        "title": "Enable Doorbell Notifications (opens persistent CTPP/VIP listener)",
        "type": "boolean",
        "default": true
      },
      "reconnectDelay": {
        "title": "Reconnect Delay (seconds)",
        "type": "integer",
        "default": 10,
        "minimum": 1,
        "maximum": 300
      },
      "subaddress": {
        "title": "ViP sub-address",
        "type": "integer",
        "minimum": 0,
        "maximum": 15,
        "description": "Row number (#) of the Comelit user whose token is used. Must not be used by another app."
      },
      "leaseRefreshMode": {
        "title": "Registration refresh mode",
        "type": "string",
        "default": "reconnect",
        "oneOf": [
          {
            "title": "Reconnect (proven)",
            "enum": [
              "reconnect"
            ]
          },
          {
            "title": "Re-register in place (no gap)",
            "enum": [
              "inplace"
            ]
          }
        ]
      },
      "leaseRefreshMinutes": {
        "title": "Registration refresh interval (minutes)",
        "type": "number",
        "default": 2,
        "minimum": 0.5,
        "maximum": 55
      },
      "leaseRecycleMinutes": {
        "title": "In-place mode: full reconnect every (minutes)",
        "type": "number",
        "default": 50,
        "minimum": 5,
        "maximum": 55
      },
      "ringWindowSeconds": {
        "title": "Allow opening only this long after a ring (seconds)",
        "type": "integer",
        "default": 90,
        "minimum": 0,
        "maximum": 600,
        "description": "0 allows opening at any time."
      },
      "doorbellTriggerUrl": {
        "title": "Doorbell camera trigger URL",
        "type": "string",
        "default": "http://localhost:8089/doorbell?Doorbell",
        "description": "Called on every ring (homebridge-camera-ffmpeg). Leave empty to disable."
      },
      "registerPush": {
        "title": "Register as a push device (original behavior)",
        "type": "boolean",
        "default": false,
        "description": "Leave off: push registration diverts calls away from Homebridge."
      },
      "answerMode": {
        "title": "Answer the ring (experimental)",
        "type": "string",
        "default": "off",
        "oneOf": [
          {
            "title": "Off",
            "enum": [
              "off"
            ]
          },
          {
            "title": "Handshake only (does not take the call)",
            "enum": [
              "handshake"
            ]
          },
          {
            "title": "Answer when opening from Home",
            "enum": [
              "answer-on-open"
            ]
          }
        ]
      }
    }
  },
  "headerDisplay": "Comelit ViP intercom, fully local. Give Homebridge its own Comelit user and use its token and row number (sub-address). See the [README](https://github.com/zmanuel1234/homebridge-comelit-doorbell#readme)."
}
