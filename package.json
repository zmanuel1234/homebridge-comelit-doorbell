{
  "name": "homebridge-comelit-doorbell",
  "displayName": "Comelit Doorbell",
  "version": "2.8.2",
  "description": "Comelit ViP intercoms (6701W/6741W Mini) in HomeKit: a video doorbell with live video, talk-back, the visitor's picture in the ring notification and HomeKit Secure Video recording, plus door unlock from Home, Siri or Apple Watch. Fully local.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "src",
    "config.schema.json",
    "homebridge-ui",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-comelit-doorbell.git"
  },
  "homepage": "https://github.com/zmanuel1234/homebridge-comelit-doorbell#readme",
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-comelit-doorbell/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/zmanuel1234"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/zmanuel"
    }
  ],
  "author": "Manuel Zamfir",
  "contributors": [
    "danimal4326 (original homebridge-comelit-intercom)"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "comelit",
    "vip",
    "intercom",
    "doorbell",
    "homekit",
    "camera",
    "video-doorbell",
    "smart-lock",
    "6701W",
    "6741W",
    "homebridge",
    "hksv",
    "homekit-secure-video",
    "comelit-vip",
    "local"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run verify",
    "verify": "npm run check && npm run lint && npm run build && npm test && node .github/scripts/check-homebridge.mjs && node .github/scripts/check-config-schema.mjs",
    "test:matrix": "npm run build && npm test",
    "release:check": "npm run verify && node .github/scripts/check-homebridge.mjs --release"
  },
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "homebridge": "^2.5.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0"
  }
}
